# Database URL
# For production (Neon / Supabase PostgreSQL):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DB]?sslmode=require"
# For local development (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Admin Authentication Secret (Generate a secure random string)
JWT_SECRET="generate-a-secure-random-secret-for-production"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"

# Safaricom Daraja M-Pesa API Credentials
# (If using development simulation, placeholder keys will automatically trigger simulated responses)
MPESA_ENV="sandbox"
MPESA_SHORTCODE="174379"
MPESA_CONSUMER_KEY="YOUR_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_MPESA_CONSUMER_SECRET"
MPESA_PASSKEY="YOUR_MPESA_PASSKEY"
MPESA_CALLBACK_URL="https://your-site.netlify.app/api/mpesa/callback"
